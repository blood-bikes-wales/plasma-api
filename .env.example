APP_NAME=PlasmaAPI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# App/journey logs → storage/logs/laravel-*.log (+ stderr for `sail logs`).
# Auth success/failure always uses the dedicated `auth` channel → storage/logs/auth-*.log.
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Plasma Controller SPA origin(s) allowed to call /api/* (CORS).
# Comma-separate multiple origins (e.g. local Vite + production).
FRONTEND_URL=http://localhost:5173

# Google Workspace authentication. GOOGLE_CLIENT_ID must be the Web OAuth
# client ID the frontend signs in with (verified as the token "aud" claim).
# Create the client in GCP Console (OAuth consent Internal, Web application).
# Locally, paste the staging client ID here.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAIN=bloodbikes.wales

# Local-only auth bypass. Honoured only in local/testing; inert when deployed.
AUTH_DISABLED=false

# Three rings API details.
THREE_RINGS_BASE_URL=https://www.3r.org.uk
THREE_RINGS_API_KEY=PfuOiUlNytwWraI5mhFjqwtt
THREE_RINGS_CONTACT_EMAIL=

# Comma-separated emails granted the local Plasma admin role (php artisan db:seed --class=AdminUserSeeder).
ADMIN_EMAILS=
